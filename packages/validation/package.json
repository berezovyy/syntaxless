{
  "name": "@syntaxless/validation",
  "version": "0.1.0",
  "description": "Convert plain English field rules to JSON Schema. On-device natural-language parser for TypeScript and JavaScript, offline, zero dependencies.",
  "keywords": [
    "constraints",
    "form-builder",
    "form-validation",
    "json-schema",
    "natural-language",
    "nlp",
    "offline",
    "on-device",
    "parser",
    "plain-english",
    "schema",
    "syntaxless",
    "typescript",
    "validation",
    "zero-dependency"
  ],
  "homepage": "https://github.com/berezovyy/syntaxless/tree/master/packages/validation#readme",
  "bugs": {
    "url": "https://github.com/berezovyy/syntaxless/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berezovyy/syntaxless.git",
    "directory": "packages/validation"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./tests/*.test.ts",
    "build": "bun run scripts/build.ts",
    "size:gate": "bun run scripts/size-gate.ts",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "test:browser": "bun run build && bun run scripts/check-browser.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "esbuild": "^0.28.2",
    "playwright": "1.62.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
