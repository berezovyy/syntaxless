{
  "name": "@syntaxless/validation",
  "version": "0.1.0",
  "description": "Natural-language field constraints to a typed intent AST and JSON Schema",
  "keywords": [
    "constraints",
    "json-schema",
    "natural-language",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./tests/*.test.ts",
    "build": "bun run scripts/build.ts",
    "size:gate": "bun run scripts/size-gate.ts",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "test:browser": "bun run build && bun run scripts/check-browser.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.28.2",
    "playwright": "1.62.0",
    "typescript": "5.9.3"
  }
}
