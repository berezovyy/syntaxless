{
  "name": "@syntaxless/cron-training",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "corpus:plan": "bun run src/llm/coverage.ts",
    "corpus:run": "bun run src/llm/runner.ts",
    "corpus:verify": "bun run src/llm/verify.ts",
    "corpus:merge": "bun run src/corpus/merge.ts",
    "corpus:audit:legacy": "bun run src/corpus/production/audit.ts",
    "featurize": "bun run src/featurize.ts",
    "featurize:kinds": "bun run src/featurize-kinds.ts packages/cron/training/data/synth/kinds.jsonl packages/cron/training/data/synth/kinds",
    "gen": "bun run src/generate.ts --split train --exclude data/synth/heldout.jsonl.fingerprints.json && bun run src/generate.ts --split validation --exclude data/synth/heldout.jsonl.fingerprints.json",
    "gen:heldout": "bun run src/generate.ts --split heldout",
    "gen:kinds": "bun run src/backward.ts",
    "fetch:tatoeba": "bun run src/mix/fetch-tatoeba.ts",
    "evaluate": "bun run src/evaluate.ts",
    "evaluate:human": "bun run src/human-evaluate.ts",
    "oracle": "bun run src/oracle.ts",
    "oracle:gate": "bun run src/oracle.ts --gate --seeds 50 --kinds-sample 200000",
    "gate": "bun run src/gate.ts",
    "experiment": "bun run src/experiment.ts",
    "corpus:source:audit": "bun run src/corpus/production/source-audit.ts",
    "corpus:source:public": "bun run src/corpus/production/public-source.ts",
    "corpus:manual": "bun run src/corpus/production/manual-source.ts data/synth/production-sources/manual-complete-v1.jsonl.gz",
    "corpus:production": "bun run src/corpus/production/build.ts next",
    "corpus:production:plan": "bun run src/corpus/production/build.ts plan",
    "corpus:production:emit": "bun run src/corpus/production/build.ts emit",
    "corpus:production:expectations": "bun run src/corpus/production/build.ts expectations",
    "corpus:production:shards": "bun run src/corpus/production/build.ts shards",
    "corpus:production:verify": "bun run src/corpus/production/build.ts verify",
    "corpus:production:publish": "bun run src/corpus/production/build.ts publish",
    "train:production": "uv run --project ../../../training/cron --locked python ../../../training/cron/train.py --run production-hidden64-v2-final-seed-20260913 --device auto --data-prefix packages/cron/training/data/synth/production-complete-v1/corpus --population-mix 0.68,0.22,0.10 --population-cover-all --epochs 2 --hidden 64 --batch 512 --auto-batch --compile --amp --prefetch --h-per-epoch --full-final-eval"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.3.15",
    "zod": "3.25.76"
  }
}
