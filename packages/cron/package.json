{
  "name": "@syntaxless/cron",
  "version": "0.0.0",
  "description": "Natural-language schedules to a typed intent AST and cron expressions",
  "keywords": [
    "cron",
    "natural-language",
    "recurrence",
    "schedule",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "test:browser": "bun run build && bun tests/browser.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "1.62.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
