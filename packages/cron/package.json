{
  "name": "@syntaxless/cron",
  "version": "0.1.0",
  "description": "Convert plain English schedules to cron expressions and next run dates. On-device natural-language parser for TypeScript and JavaScript, offline, zero dependencies.",
  "keywords": [
    "cron",
    "cron-expression",
    "crontab",
    "natural-language",
    "nlp",
    "offline",
    "on-device",
    "parser",
    "plain-english",
    "recurrence",
    "schedule",
    "scheduler",
    "syntaxless",
    "typescript",
    "zero-dependency"
  ],
  "homepage": "https://github.com/berezovyy/syntaxless/tree/master/packages/cron#readme",
  "bugs": {
    "url": "https://github.com/berezovyy/syntaxless/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berezovyy/syntaxless.git",
    "directory": "packages/cron"
  },
  "files": [
    "dist",
    "!dist/evaluation.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js",
      "default": "./dist/temporal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./src ./tests",
    "build": "bun run scripts/build.ts",
    "size:gate": "bun run scripts/size-gate.ts",
    "check:package": "bun run build && bun run scripts/check-package.ts",
    "test:browser": "bun run build && bun run scripts/check-browser.ts",
    "smoke": "bun run build && bun run scripts/smoke.ts"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@types/bun": "1.4.2",
    "esbuild": "^0.28.2",
    "playwright": "1.62.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=18"
  }
}
