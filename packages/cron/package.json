{
  "name": "@syntaxless/cron",
  "version": "0.1.0",
  "description": "Natural-language schedules to a typed intent AST and cron expressions",
  "keywords": [
    "cron",
    "natural-language",
    "recurrence",
    "schedule",
    "typescript"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js",
      "default": "./dist/temporal.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./src ./tests",
    "build": "bun run scripts/build.ts",
    "size:gate": "bun run scripts/size-gate.ts",
    "check:package": "bun run scripts/check-package.ts",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "test:browser": "bun run build && bun tests/browser.ts"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@types/bun": "latest",
    "esbuild": "^0.28.2",
    "playwright": "1.62.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
